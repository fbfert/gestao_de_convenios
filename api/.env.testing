# Ambiente de TESTE ponta a ponta (Playwright).
#
# Este arquivo existe por um motivo de segurança, e não de conveniência: o
# script `npm run test:e2e` roda
#
#     php artisan migrate:fresh --seed --env=testing --force
#
# e o Laravel só usa `--env=testing` se ESTE arquivo existir. Sem ele, o comando
# cai no `.env` normal e o `migrate:fresh` apaga o banco de desenvolvimento —
# que nesta máquina é a cópia restaurada da produção.
#
# Por isso o banco abaixo é OUTRO (`gestao_convenios_e2e`), no mesmo MariaDB.
# Banco separado em vez de SQLite para o teste rodar no mesmo motor da produção.

APP_NAME="Gestao de Convenios (e2e)"
APP_ENV=testing
# Chave PROPRIA do ambiente de teste. Nao e a de desenvolvimento nem a de
# producao: este arquivo e versionado, e uma chave compartilhada aqui vazaria
# para o repositorio. Ela so cifra sessao de teste sobre dado semeado.
APP_KEY=base64:+GynOOb2t8HtGVHnQd34y8IhPFkGmLETGLTGFv43fbw=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://127.0.0.1:8001

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gestao_convenios_e2e
DB_USERNAME=gestao_convenios
DB_PASSWORD=secret

SESSION_DRIVER=file
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file
CACHE_PREFIX=e2e_

# Nada sai da maquina durante o teste.
MAIL_MAILER=array
MAIL_FROM_ADDRESS="e2e@example.com"
MAIL_FROM_NAME="${APP_NAME}"

SEED_ADMIN_PASSWORD=password

# ATENCAO — O PHPUNIT TAMBEM LE ESTE ARQUIVO.
#
# O `phpunit.xml` define APP_ENV=testing, e o Laravel carrega `.env.{APP_ENV}`
# quando ele existe. Ou seja: tudo que estiver aqui vale para a suite unitaria
# tambem, e nao so para a ponta a ponta.
#
# Isso ja mordeu uma vez: um `LOGIN_TENTATIVAS_POR_MINUTO=100` colocado aqui
# afrouxou o limite dentro do proprio AuthApiTest, que existe para provar que a
# sexta tentativa e barrada — o teste passou a nao testar nada.
#
# Portanto: ajuste que vale SO para a ponta a ponta nao entra neste arquivo. Ele
# vai no `env` do `webServer` em `web/playwright.config.ts`, que so afeta o
# processo levantado pelo Playwright.
#
# O que fica aqui e o que os dois ambientes podem compartilhar; as chaves de
# banco acima sao sobrescritas pelo `force="true"` do `phpunit.xml`, que manda a
# suite unitaria para SQLite em memoria.

SANCTUM_STATEFUL_DOMAINS=127.0.0.1:4174
