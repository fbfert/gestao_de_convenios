# Copie para .secrets.env (chmod 600) e preencha. NUNCA versionar o .secrets.env.
# Consumido por: docker compose --env-file deploy/.secrets.env -f deploy/docker-compose.prod.yml

# Senha do usuario da aplicacao (gestao_convenios) no MariaDB.
# Precisa bater com DB_PASSWORD do api/.env.
DB_PASS=

# Senha do root do MariaDB (usada para dump/restore e manutencao).
DB_ROOT=
